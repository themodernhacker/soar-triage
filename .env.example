# soar-triage configuration.
# Copy this file to .env and fill in real values.  NEVER commit .env; it is
# gitignored from the first commit, and only this .example (placeholders only) is tracked.

# --- GitHub (for the ticket step) ---------------------------------------------
# Use a FINE-GRAINED personal access token scoped to "Issues: Read and write" on
# ONLY the soar-triage repo, nothing broader. A leaked token in a security repo is
# a genuinely bad look; treat it the way you'd want a hiring manager to see.
GITHUB_TOKEN=github_pat_PLACEHOLDER_do_not_commit_real_value
GITHUB_REPO=themodernhacker/soar-triage

# --- AbuseIPDB (for the enrichment step, optional) ----------------------------
# Free tier: 1,000 checks/day, no card. The lab's own traffic is RFC 1918, so it
# is classified locally and this lookup is skipped; a key is only exercised on
# genuinely public source IPs. Leave blank to always skip the external lookup.
ABUSEIPDB_API_KEY=

# --- Optional -----------------------------------------------------------------
# Where the structured triage decision log (JSON, with reasoning) is written
# (default: logs/decisions.log). In the manager, point it somewhere the wazuh
# user can write, e.g.:
# SOAR_TRIAGE_LOG=/var/ossec/logs/soar-triage-decisions.log

# Where the human-readable enrich -> triage -> ticket trace is written. Wazuh's
# integratord sends the integration's stdout to /dev/null, so set this to capture
# the trace from a live run:
# SOAR_TRIAGE_TRACE=/var/ossec/logs/soar-triage.log
